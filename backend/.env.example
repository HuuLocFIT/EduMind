# ===========================
# Auth Service Configuration
# ===========================
AUTH_SERVICE_PORT=8081
AUTH_DB_URL=jdbc:postgresql://localhost:5432/edumind_auth
AUTH_DB_NAME=edumind_auth
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=changeme
AUTH_DB_DRIVER=org.postgresql.Driver

# ===========================
# LML Core Service Configuration
# ===========================
LMS_CORE_SERVICE_PORT=8083
LMS_CORE_DB_URL=jdbc:postgresql://localhost:5433/edumind_core
LMS_CORE_DB_NAME=edumind_core
LMS_CORE_DB_USERNAME=postgres
LMS_CORE_DB_PASSWORD=changeme
LMS_CORE_DB_DRIVER=org.postgresql.Driver

# ===========================
# Email Configuration
# ===========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@edumind.com
MAIL_ENABLED=true

# ===========================
# OAuth Configuration
# ===========================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI={baseUrl}/api/auth/login/oauth2/code/{registrationId}

# ===========================
# JWT Configuration
# ===========================
JWT_SECRET=replace-with-256-bit-secret
JWT_EXPIRATION=900000 #15 minutes
JWT_REFRESH_EXPIRATION=604800000 #7 days

# ===========================
# Frontend + Encryption
# ===========================
FRONTEND_URL=http://localhost:3000
AUTH_SERVICE_ENCRYPTION_KEY=base64-encoded-32-byte-key
LMS_CORE_SERVICE_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ===========================
# Review Auto Approved Mode
# ===========================
REVIEW_AUTO_APPROVE_ENABLED=true
REVIEW_AUTO_APPROVE_THRESHOLD=0

# ===========================
# Cloudinary Configuration
# ===========================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# ===========================
# API Gateway / Redis
# ===========================
API_GATEWAY_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=60000ms
GATEWAY_URL=http://localhost:8080

# ===========================
# Discovery / Eureka
# ===========================
DISCOVERY_SERVER_PORT=8761
EUREKA_HOSTNAME=localhost
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# ===========================
# Payment 
# ===========================
PAYMENT_GATEWAY=paypal          # or sepay

# PayPal
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=xxxxx

# SePay
SEPAY_API_KEY=xxxxx
SEPAY_MERCHANT_ID=xxxxx
SEPAY_SECRET_KEY=xxxxx
SEPAY_WEBHOOK_SECRET=xxxxx