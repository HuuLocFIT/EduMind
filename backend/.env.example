# App Info
APP_BASE_URL=http://localhost:8080
# When true (default), only paid courses can issue certificates.
# When false, free courses can also issue certificates.
APP_CERTIFICATE_REQUIRE_PAID_COURSE=true

# ===========================
# Auth Service Configuration
# ===========================
AUTH_SERVICE_PORT=8081
AUTH_DB_URL=jdbc:postgresql://localhost:5432/edumind_auth
AUTH_DB_NAME=edumind_auth
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=changeme
AUTH_DB_DRIVER=org.postgresql.Driver

# Native runs may select a Spring profile here. docker-compose.prod.yml forces
# the prod profile for all four application services.
SPRING_PROFILES_ACTIVE=
# Must be true in production (refresh-token cookie requires HTTPS).
COOKIE_SECURE=false
# Refresh-token cookie SameSite policy: Lax, Strict, or None.
COOKIE_SAME_SITE=Lax

# ===========================
# LMS Core Service Configuration
# ===========================
LMS_CORE_SERVICE_PORT=8083
LMS_CORE_DB_URL=jdbc:postgresql://localhost:5433/edumind_core
LMS_CORE_DB_NAME=edumind_core
LMS_CORE_DB_USERNAME=postgres
LMS_CORE_DB_PASSWORD=changeme
LMS_CORE_DB_DRIVER=org.postgresql.Driver

# ===========================
# Email Configuration
# ===========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENABLED=true
# Dedicated HMAC key and fixed-window allowance for verification resends.
# Use a distinct secret from the password-reset limiter and encryption keys.
EMAIL_VERIFICATION_LIMITER_HMAC_KEY=<generate-with-openssl-rand-hex-32>
EMAIL_VERIFICATION_RESEND_MAX=3
SUPPORT_EMAIL=your-support-email@gmail.com
EMAIL_EXECUTOR_CORE_POOL_SIZE=2
EMAIL_EXECUTOR_MAX_POOL_SIZE=4
EMAIL_EXECUTOR_QUEUE_CAPACITY=100

# ===========================
# OAuth Configuration
# ===========================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI={baseUrl}/api/auth/login/oauth2/code/{registrationId}

# ===========================
# JWT Configuration
# ===========================
JWT_SECRET=replace-with-256-bit-secret
# 15 minutes
JWT_EXPIRATION=900000
# 7 days
JWT_REFRESH_EXPIRATION=604800000

# ===========================
# Frontend + Encryption
# ===========================
FRONTEND_URL=http://localhost:3000
# Enable only in local development when running the E2E account seeder.
DEV_VERIFY_ENDPOINT_ENABLED=false
# Enforce verification for local email/password accounts
ENFORCE_EMAIL_VERIFICATION=true
# Generate a different key for each service with: openssl rand -base64 32
AUTH_SERVICE_ENCRYPTION_KEY=
LMS_CORE_SERVICE_ENCRYPTION_KEY=

# Dedicated secret used to HMAC-hash emails in the password-reset rate limiter
# (PasswordResetRateLimiter). Must be distinct from AUTH_SERVICE_ENCRYPTION_KEY -
# it is a different key for a different purpose (rate-limit bucket hashing vs.
# at-rest encryption), so a compromise of one does not compromise the other.
# Generate a strong random value, e.g.: openssl rand -hex 32
PASSWORD_RESET_LIMITER_HMAC_KEY=<generate-with-openssl-rand-hex-32>

# ===========================
# Review Auto Approved Mode
# ===========================
REVIEW_AUTO_APPROVE_ENABLED=true
REVIEW_AUTO_APPROVE_THRESHOLD=0

# ===========================
# Cloudinary Configuration
# ===========================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
VIDEO_HLS_ENABLED=false

# ===========================
# API Gateway / Redis
# ===========================
API_GATEWAY_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=60000ms
GATEWAY_URL=http://localhost:8080
# Public health responses should not expose component details by default.
ACTUATOR_HEALTH_DETAILS=never

# ===========================
# Discovery / Eureka
# ===========================
DISCOVERY_SERVER_PORT=8761
EUREKA_HOSTNAME=localhost

# HTTP Basic credentials for the Eureka registry and dashboard.
# Dev defaults are eureka/eureka; the prod profile requires both to be set.
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka

# Registry URL without credentials: clients authenticate with an Authorization header
# built from EUREKA_USERNAME / EUREKA_PASSWORD (see backend/eureka-client-security).
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# JVM options for the Discovery Service container
DISCOVERY_JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# PAYMENT
PAYMENT_MOCK_ENABLED=true
PAYMENT_PAYPAL_ENABLED=false
PAYMENT_SEPAY_ENABLED=false

# Safe local default. Set to paypal or sepay only after enabling and configuring it.
PAYMENT_GATEWAY=mock

# PAYPAL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Must be publicly reachable when PayPal is enabled.
PAYPAL_RETURN_BASE_URL=http://localhost:3000
PAYPAL_WEBHOOK_ID=

# SEPAY
SEPAY_API_KEY= 
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_BASE_URL=https://my.sepay.vn
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
# Human-readable bank name shown as the accessible text alternative to the QR code
# (e.g. "MB Bank"). Falls back to SEPAY_BANK_CODE when empty.
SEPAY_BANK_NAME=

# REFUNDS
PAYMENT_REFUND_AUTO_APPROVE_DAYS=7
PAYMENT_REFUND_MAX_DAYS=30
PAYMENT_REFUND_PARTIAL_THRESHOLD=50

# PAYOUTS
PAYMENT_PAYOUT_MINIMUM_AMOUNT=50
PAYMENT_PAYOUT_HOLD_PERIOD=30
PAYMENT_PAYOUT_SCHEDULE_DAY=1
PAYMENT_PAYOUT_SCHEDULE_HOUR=2
PAYMENT_PAYOUT_MAX_RETRIES=3

# AI
GEMINI_API_KEY=
GROQ_API_KEY=
# yt-dlp binary path, only used for the YouTube-caption fallback (optional, defaults to "yt-dlp" on PATH)
YTDLP_PATH=

# AI executor pools (optional, sensible defaults apply if unset)
AI_CORE_POOL_SIZE=2
AI_MAX_POOL_SIZE=5
AI_QUEUE_CAPACITY=50
WHISPER_QUEUE_CAPACITY=10

# App-wide async executor (optional)
APP_ASYNC_CORE_POOL_SIZE=10
APP_ASYNC_MAX_POOL_SIZE=20
APP_ASYNC_QUEUE_CAPACITY=50

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Admin frontend origin (used by api-gateway CORS + docker-compose)
ADMIN_URL=http://localhost:4200

# ===========================
# Production image selection
# ===========================
# Both values are required by docker-compose.prod.yml. Use an immutable commit tag.
GITHUB_REPOSITORY_OWNER=huulocfit
IMAGE_TAG=replace-with-short-git-sha
