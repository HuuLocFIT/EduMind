{
  "name": "@frontend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "start": "nx run-many -t serve",
    "start:user": "nx serve user",
    "start:admin": "nx serve admin",
    "build": "nx run-many -t build",
    "build:user": "nx build user",
    "build:user:full": "nx run user:prerender",
    "build:admin": "nx build admin",
    "test": "nx run-many -t test",
    "test:user": "nx test user",
    "test:user:watch": "nx test user --watch",
    "test:user:coverage": "nx test user --coverage",
    "test:admin": "nx test admin",
    "test:admin:watch": "nx test admin --watch",
    "test:admin:coverage": "nx test admin --coverage",
    "lint": "nx run-many -t lint",
    "lint:a11y": "eslint apps/user/src libs/user/ui/src",
    "graph": "nx graph",
    "reset": "nx reset",
    "e2e": "node --env-file=.env.e2e ./node_modules/.bin/playwright test --config=e2e/playwright.config.ts",
    "e2e:user": "node --env-file=.env.e2e ./node_modules/.bin/playwright test --config=e2e/playwright.config.ts --project=user-app",
    "e2e:admin": "node --env-file=.env.e2e ./node_modules/.bin/playwright test --config=e2e/playwright.config.ts --project=admin-app",
    "e2e:ui": "node --env-file=.env.e2e ./node_modules/.bin/playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "test:a11y": "playwright test --config=e2e/playwright.config.ts --project=user-app --grep @a11y",
    "test:a11y:public": "playwright test --config=e2e/playwright.config.ts --project=user-app --grep @a11y-public",
    "test:a11y:auth": "playwright test --config=e2e/playwright.config.ts --project=user-app --grep @a11y-auth",
    "test:a11y:purchase": "playwright test --config=e2e/playwright.config.ts --project=user-app --grep @a11y-purchase",
    "test:a11y:learning": "playwright test --config=e2e/playwright.config.ts --project=user-app --grep @a11y-learning",
    "pa11y": "node e2e/pa11y/run.cjs",
    "pa11y:ci": "node e2e/pa11y/run.cjs --ci",
    "test:a11y:report": "playwright show-report e2e/playwright-report"
  },
  "private": true,
