{
  "$schema": "./node_modules/nx/schemas/tsconfig-schema.json",
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "customConditions": ["@frontend/source"],
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@edumind/admin-ui": [
        "libs/admin/ui/src/index.ts"
      ],
      "@edumind/user-ui": [
        "libs/user/ui/src/index.ts"
      ],
      "@edumind/shared-types": [
        "libs/shared/types/src/index.ts"
      ],
      "@edumind/shared-constants": [
        "libs/shared/constants/src/index.ts"
      ],
      "@edumind/shared-utils": [
        "libs/shared/utils/src/index.ts"
      ],
      "@admin/core/*": [
        "apps/admin/src/app/core/*"
      ],
      "@admin/features/*": [
        "apps/admin/src/app/features/*"
      ],
      "@admin/layouts/*": [
        "apps/admin/src/app/layouts/*"
      ],
      "@admin/environments/*": [
        "apps/admin/src/environments/*"
      ],
      "@user/services/*": [
        "apps/user/src/app/services/*"
      ],
      "@user/stores/*": [
        "apps/user/src/app/stores/*"
      ],
      "@user/components/*": [
        "apps/user/src/app/components/*"
      ],
      "@user/pages/*": [
        "apps/user/src/app/pages/*"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
